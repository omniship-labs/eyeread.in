{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the eyeread.in app windows. The pack host (packhost) is deliberately absent: it gets no capabilities and no app commands.",
  "windows": ["main", "overlay", "about", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-is-visible",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-current-monitor",
    "core:window:allow-cursor-position",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-content-protected",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-visible-on-all-workspaces",
    "core:window:allow-unminimize",
    "core:webview:default",
    "core:event:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "x-apple.systempreferences:*"
        }
      ]
    },
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "store:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "os:default",
    "process:default",
    "process:allow-restart",
    "window-state:default",
    "window-state:allow-save-window-state",
    "window-state:allow-restore-state",
    "allow-check-for-update",
    "allow-download-update",
    "allow-install-update",
    "allow-show-about-window",
    "allow-set-app-protected",
    "allow-set-dock-hidden",
    "allow-attach-window-to-all-spaces",
    "allow-packs-apps-status",
    "allow-packs-apps-set-enabled",
    "allow-packs-apps-revoke",
    "allow-packs-apps-resolve-pairing",
    "allow-packs-inspect",
    "allow-packs-inspect-bytes",
    "allow-packs-install",
    "allow-packs-uninstall",
    "allow-packs-list",
    "allow-packs-set-enabled",
    "allow-packs-net-log",
    "allow-packs-net-clear-log",
    "allow-packs-rpc-result",
    "allow-packs-prompter-state",
    "allow-packs-grants",
    "allow-packs-set-grant",
    "allow-packs-settings-get",
    "allow-packs-settings-set",
    "allow-packs-logs"
  ]
}
