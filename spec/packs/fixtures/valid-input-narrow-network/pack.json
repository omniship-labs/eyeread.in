{
  "apiVersion": 1,
  "name": "Fixture",
  "version": "1.0.0",
  "author": {
    "name": "Fixture Author"
  },
  "license": "AGPL-3.0-only",
  "main": "main.js",
  "id": "com.example.input-narrow",
  "permissions": {
    "prompter:control": {
      "input": {
        "keyboard": {
          "keys": [
            "ArrowRight",
            "ArrowLeft"
          ]
        },
        "mouse": {
          "buttons": [
            3,
            4
          ]
        }
      },
      "network": [
        "https://api.example.com"
      ]
    },
    "scripts:write": {
      "network": [
        "https://api.notion.com"
      ]
    }
  }
}
