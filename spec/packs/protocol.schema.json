{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omniship-labs/eyeread.in/blob/main/spec/packs/protocol.schema.json",
  "title": "eyeread.in host <-> sandbox message, v1",
  "description": "ArrayBuffer fields can't be expressed in JSON Schema; they are typed as objects here and checked with instanceof by the host.",
  "type": "object",
  "required": ["v", "type"],
  "properties": {
    "v": { "const": 1 },
    "type": {
      "enum": [
        "init",
        "ready",
        "activate",
        "call",
        "result",
        "event",
        "log",
        "error",
        "ping",
        "pong"
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/init" },
    { "$ref": "#/$defs/ready" },
    { "$ref": "#/$defs/activate" },
    { "$ref": "#/$defs/call" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/log" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/ping" },
    { "$ref": "#/$defs/pong" }
  ],
  "$defs": {
    "permission": { "$ref": "pack.schema.json#/$defs/permission" },
    "settings": {
      "type": "object",
      "propertyNames": { "$ref": "pack.schema.json#/$defs/settingKey" },
      "additionalProperties": { "type": ["boolean", "number", "string"] }
    },
    "init": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "apiVersion", "pack", "sandbox", "settings"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "init" },
        "apiVersion": { "const": 1 },
        "pack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "name"],
          "properties": {
            "id": { "$ref": "pack.schema.json#/$defs/packId" },
            "version": { "$ref": "pack.schema.json#/$defs/version" },
            "name": { "type": "string" }
          }
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "permissions", "network"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "permissions": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/permission" }
            },
            "network": { "type": "boolean" }
          }
        },
        "settings": { "$ref": "#/$defs/settings" }
      }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "handlers"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "ready" },
        "handlers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/permission" }
        }
      }
    },
    "activate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "permission"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "activate" },
        "permission": { "$ref": "#/$defs/permission" }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "id", "permission", "method", "params"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "call" },
        "id": { "type": "integer", "minimum": 1 },
        "permission": { "anyOf": [{ "$ref": "#/$defs/permission" }, { "type": "null" }] },
        "method": {
          "enum": [
            "scripts.add",
            "prompter.load",
            "prompter.control",
            "prompter.getState",
            "prompter.subscribe",
            "prompter.unsubscribe",
            "files.import",
            "net.fetch",
            "settings.get"
          ]
        },
        "params": { "type": "object" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "id", "ok"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "result" },
        "id": { "type": "integer", "minimum": 1 },
        "ok": { "type": "boolean" },
        "value": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "E_PERMISSION",
                "E_NETWORK_DENIED",
                "E_NETWORK",
                "E_TIMEOUT",
                "E_TOO_LARGE",
                "E_RATE_LIMITED",
                "E_INVALID_ARGUMENT",
                "E_NO_SESSION",
                "E_BUSY",
                "E_UNSUPPORTED",
                "E_INTERNAL"
              ]
            },
            "message": { "type": "string" }
          }
        }
      },
      "if": { "properties": { "ok": { "const": true } } },
      "then": { "required": ["value"], "not": { "required": ["error"] } },
      "else": { "required": ["error"], "not": { "required": ["value"] } }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "name", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "event" },
        "name": { "enum": ["prompter.state", "settings.changed"] },
        "data": { "type": "object" }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "level", "args"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "log" },
        "level": { "enum": ["debug", "info", "warn", "error"] },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 4096 }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "message", "fatal"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "error" },
        "message": { "type": "string", "maxLength": 4096 },
        "stack": { "type": "string", "maxLength": 16384 },
        "fatal": { "type": "boolean" }
      }
    },
    "ping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "seq"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "ping" },
        "seq": { "type": "integer", "minimum": 0 }
      }
    },
    "pong": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "seq"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "pong" },
        "seq": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
